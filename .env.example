# ============================================
# Database (PostgreSQL)
# ============================================
DATABASE_URL=postgresql+asyncpg://logmoni_user:logmoni_secret@localhost:5432/logmoni
DATABASE_URL_SYNC=postgresql://logmoni_user:logmoni_secret@localhost:5432/logmoni

# ============================================
# Message Queue (RabbitMQ)
# ============================================
RABBITMQ_URL=amqp://logmoni:logmoni_secret@localhost:5672/
RABBITMQ_QUEUE_NAME=log_events

# ============================================
# Application
# ============================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Alert thresholds
ALERT_ERROR_RATE_THRESHOLD=10
ALERT_SPAM_IP_THRESHOLD=100
ALERT_WINDOW_MINUTES=5

# ============================================
# Frontend
# ============================================
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/alerts
